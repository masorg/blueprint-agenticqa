# Copy to .env and fill in. All vars are prefixed AGENTICQA_ (see config.py).
# .env is gitignored; this template is safe to commit.

# ── LLM provider ────────────────────────────────────────────────────────────
# "stub"   = deterministic heuristics, no key needed (Phase 2 default)
# "openai" = real routing/classification/triage via OpenAI
# "cloudera" = OpenAI-compatible Cloudera AI Inference endpoint
AGENTICQA_LLM_PROVIDER=openai

# OpenAI (primary). Leave base_url blank for api.openai.com.
AGENTICQA_OPENAI_API_KEY=sk-...
AGENTICQA_OPENAI_MODEL=gpt-4o
# AGENTICQA_OPENAI_BASE_URL=

# Shared client tuning (optional; defaults shown)
# AGENTICQA_LLM_TIMEOUT_SECONDS=40
# AGENTICQA_LLM_MAX_RETRIES=1

# Mistral (OpenAI-compatible; used for the cross-provider evaluation runs, or set
# AGENTICQA_LLM_PROVIDER=mistral). Base URL defaults to https://api.mistral.ai/v1.
# AGENTICQA_MISTRAL_API_KEY=
# AGENTICQA_MISTRAL_MODEL=mistral-large-latest

# Cloudera AI Inference (only if AGENTICQA_LLM_PROVIDER=cloudera)
# AGENTICQA_CLOUDERA_AI_ENDPOINT=https://.../v1
# AGENTICQA_CLOUDERA_AI_API_KEY=
# AGENTICQA_CLOUDERA_MODEL=

# ── App ─────────────────────────────────────────────────────────────────────
# AGENTICQA_APP_API_KEY=            # required on the trigger endpoint (empty = dev)
# AGENTICQA_SEED_SAMPLES=1          # 0 for a clean, empty dashboard

# ── GitHub integration ───────────────────────────────────────────────────────
# HMAC secret verifying every inbound webhook (org webhook OR App OR relay).
# AGENTICQA_GITHUB_WEBHOOK_SECRET=
# AGENTICQA_GITHUB_API_URL=https://api.github.com   # e.g. GHES: https://ghe.co/api/v3
# AGENTICQA_GITHUB_STATUS_CONTEXT=agentic-qa/review
# Makes the PR check's "Details" link point back at this app's run page.
# AGENTICQA_PUBLIC_BASE_URL=        # e.g. https://<app>.<cml-domain>
#
# Auth — pick ONE:
#   (A) Org webhook + bot token (primary): add ONE org webhook pointing at
#       /api/v1/github/webhook (subscribe Pull requests + Issue comments), and a
#       machine-user / org PAT with repo read+write for the outbound status+comments.
# AGENTICQA_GITHUB_TOKEN=
#   (B) GitHub App: install once on the org (per-installation scoped tokens, no
#       long-lived PAT). Needs the App id + its private key.
# AGENTICQA_GITHUB_APP_ID=
# AGENTICQA_GITHUB_APP_PRIVATE_KEY_PATH=/path/to/agentic-qa.private-key.pem  # preferred
# AGENTICQA_GITHUB_APP_PRIVATE_KEY=       # alt: PEM inline (\n-escaped or base64)
#
# Operator-side allowlist — the "whitelist an enterprise/org" control knob.
# Comma-separated, case-insensitive. Both blank = act on every delivered event.
# An event passes if its org OR its enterprise is listed.
# AGENTICQA_GITHUB_ALLOWED_ORGS=acme,acme-labs
# AGENTICQA_GITHUB_ALLOWED_ENTERPRISES=acme-inc
